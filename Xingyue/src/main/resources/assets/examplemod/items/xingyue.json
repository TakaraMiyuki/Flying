{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "ground", "fixed", "on_shelf"],
        "model": { "type": "minecraft:model", "model": "examplemod:item/xingyue_gui" }
      }
    ],
    "fallback": { "type": "minecraft:model", "model": "examplemod:item/xingyue_hand" }
  }
}
